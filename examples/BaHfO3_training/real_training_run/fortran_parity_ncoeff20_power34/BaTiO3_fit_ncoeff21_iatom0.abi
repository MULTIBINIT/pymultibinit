# BaTiO3 MULTIBINIT nearest valid power 3-4 fitting case for 20-term parity checks.
# fit_iatom=0 loops over three irreducible atoms, so fit_ncoeff must be divisible by 3.

outdata_prefix "BaTiO3_fit_ncoeff21_iatom0"
latt_harm_pot_fname "/home/hexu/projects/atomchain_dev/atomchain/.tmp/batio3_ddb_example/BaTiO3_stress.ddb"
latt_training_set_fname "/home/hexu/projects/atomchain_dev/pymultibinit/examples/BaTiO3_training/real_training_run/BaTiO3_multibinit_HIST.nc"

ngqpt 2 2 2
dipdip 0
asr 0
ncell 2 2 2

prt_model 4
fit_coeff 1
fit_EFS 1 1 1
fit_iatom 0
fit_ncoeff 21
fit_generateCoeff 1
fit_rangePower 3 4
fit_dispterms 1
fit_anhaStrain 0
fit_SPCoupling 0
fit_cutoff 8.0
ts_option 0

dynamics 0
ntime 0
