# BaTiO3 MULTIBINIT fitting attempt using code-generated atomchain DDB.

outdata_prefix "BaTiO3_fit"
latt_harm_pot_fname "/home/hexu/projects/atomchain_dev/atomchain/.tmp/batio3_ddb_example/BaTiO3_stress_energy.ddb"
latt_training_set_fname "/home/hexu/projects/atomchain_dev/pymultibinit/examples/BaTiO3_training/real_training_run/BaTiO3_multibinit_HIST.nc"

