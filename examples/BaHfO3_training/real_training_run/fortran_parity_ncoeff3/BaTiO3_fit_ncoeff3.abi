# BaTiO3 MULTIBINIT small fitting case for Python/Fortran parity checks.

outdata_prefix "BaTiO3_fit_ncoeff3"
latt_harm_pot_fname "/home/hexu/projects/atomchain_dev/atomchain/.tmp/batio3_ddb_example/BaTiO3_stress.ddb"
latt_training_set_fname "/home/hexu/projects/atomchain_dev/pymultibinit/examples/BaTiO3_training/real_training_run/BaTiO3_multibinit_HIST.nc"

ngqpt 2 2 2
dipdip 0
asr 0
ncell 2 2 2

